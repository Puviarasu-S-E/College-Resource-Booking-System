generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     Role      @default(USER)
  bookings Booking[]
}

model Resource {
  id          Int       @id @default(autoincrement())
  name        String
  category    String
  description String
  bookings    Booking[]
}

model Booking {
  id              Int           @id @default(autoincrement())
  userId          Int
  resourceId      Int
  date            DateTime
  startTime       String
  endTime         String
  status          BookingStatus @default(PENDING)
  rejectionReason String?
  user            User          @relation(fields: [userId], references: [id])
  resource        Resource      @relation(fields: [resourceId], references: [id])
}
